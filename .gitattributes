# Normalize line endings — text files always LF in the repo
* text=auto eol=lf

# JS / TS source
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.d.ts text eol=lf

# Config / docs
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Lockfiles — keep as-is, mark as generated for cleaner diffs
package-lock.json -diff linguist-generated
yarn.lock -diff linguist-generated
pnpm-lock.yaml -diff linguist-generated

# Shell scripts
*.sh text eol=lf

# Binary — no diff, no eol conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
