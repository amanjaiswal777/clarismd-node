{
  "name": "@clarismd/sdk",
  "version": "0.1.0",
  "description": "Open-source AI gateway with PHI-aware governance — TypeScript client",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:workers": "vitest run --config vitest.workerd.config.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests examples",
    "format:check": "prettier --check src tests examples",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "codegen": "bash scripts/codegen.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "clarismd",
    "llm",
    "openai",
    "healthcare",
    "phi",
    "audit",
    "ai-gateway",
    "fetch",
    "isomorphic"
  ],
  "homepage": "https://github.com/amanjaiswal777/clarismd-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amanjaiswal777/clarismd-node.git"
  },
  "bugs": {
    "url": "https://github.com/amanjaiswal777/clarismd-node/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
